/build
/target
/.qtcreator
/.vs
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Tool virtual environment. The directory is tracked so the convention is visible;
# its contents are not.
/tools/.venv/*
!/tools/.venv/.gitkeep

# Bytecode, which appears as soon as anything imports a tool rather than running it.
__pycache__/
*.pyc

# The golden generator's local build litter - the goldens are what gets committed.
*.obj
generate_physics_goldens.exe
