/build
/target
/.qtcreator
/.vs
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Tool virtual environment. The directory is tracked so the convention is visible;
# its contents are not.
/tools/.venv/*
!/tools/.venv/.gitkeep

# Bytecode, which appears as soon as anything imports a tool rather than running it.
__pycache__/
*.pyc

# The golden generator's local build litter - the goldens are what gets committed.
*.obj
generate_physics_goldens.exe

# The pinned markdown linter, installed by `npm ci`; the lock file is tracked, the modules are not.
/node_modules/

# Side build directories the deep tier runs in while target/ is locked.
target-*/
